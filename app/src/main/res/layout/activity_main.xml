<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Radio Boss Mobile - Panel de Control"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Streaming Connection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuración de Transmisión (Listen2MyRadio)"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etServerIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="IP del Servidor o Link (e.g., s4.listen2myradio.com)"/>

        <EditText
            android:id="@+id/etPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Puerto"
            android:inputType="number"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña de Transmisión"
            android:inputType="textPassword"/>

        <Button
            android:id="@+id/btnToggleStream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar Transmisión En Vivo"
            android:layout_marginBottom="15dp"/>

        <!-- Playlist and Audio Utilities -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Playlist &amp; Automatización"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnLoadPlaylist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargar / Crear Playlist (.m3u)"/>

        <Button
            android:id="@+id/btnScheduleAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Programar Cuña / Publicidad por Hora"/>

        <Button
            android:id="@+id/btnSayTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Botonera: Decir la Hora Actual"
            android:layout_marginBottom="15dp"/>

        <!-- Soundboard Effects -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Botonera de Efectos Especiales"
            android:textStyle="bold"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginTop="5dp">

            <Button
                android:id="@+id/btnFx1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Efecto Aplausos" />

            <Button
                android:id="@+id/btnFx2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Efecto Aire / Horn" />
        </GridLayout>

        <!-- Live Mic -->
        <ToggleButton
            android:id="@+id/btnMicToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textOn="Micrófono Abierto (Hablar)"
            android:textOff="Micrófono Mutado"
            android:layout_marginTop="15dp"/>

    </LinearLayout>
</ScrollView>
